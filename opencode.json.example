{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "vision": {
      "type": "local",
      "command": ["node", "/path/to/vision-mcp/index.js"],
      "enabled": true,
      "environment": {
        "VISION_API_KEY": "sk-...",
        "VISION_MODEL": "gpt-4o-mini",
        "VISION_API_URL": "https://api.openai.com/v1"
      }
    }
  }
}
